    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Create a random number generator with a seed\n",
    "rng = np.random.default_rng(seed=42)\n",
    "\n",
    "# Create a test 10x3 dataframe\n",
    "df = pd.DataFrame({\n",
    "    \"A\": np.arange(1, 11),\n",
    "    \"B\": rng.integers(10, 100, size=10),\n",
    "    \"C\": rng.choice([\"w\", \"x\", \"y\", \"z\"], size=10)\n",
    "})\n",
    "\n",
    "print(df)\n",
    "\n",
    "# Select rows subset\n",
    "subset = df[df['C'] == 'w']\n",
    "\n",
    "print(\"Subset has\", len(subset), \"rows.\")"
   ]
